{
  "name": "fbx-exporter",
  "version": "0.1.0",
  "type": "module",
  "description": "A from-scratch binary FBX exporter for browser and Node character pipelines.",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./document/static": "./src/document/static-document.js",
    "./validation": "./src/validation/fbx-binary-validator.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fbx",
    "exporter",
    "three",
    "threejs",
    "animation",
    "skinning",
    "mixamo",
    "browser"
  ],
  "scripts": {
    "sample": "node scripts/write-minimal-fbx.js",
    "sample:static": "node scripts/write-static-mesh-fbx.js",
    "sample:feature": "node scripts/write-feature-sample-fbx.js",
    "sample:feature:compressed": "node scripts/write-feature-sample-fbx.js --compressed",
    "sample:hierarchy": "node scripts/write-hierarchy-sample-fbx.js",
    "sample:material": "node scripts/write-material-sample-fbx.js",
    "sample:mixamo": "node scripts/write-mixamo-round-trip-sample-fbx.js",
    "sample:mixamo:compressed": "node scripts/write-mixamo-round-trip-sample-fbx.js --compressed",
    "sample:mixamo:embedded": "node scripts/write-mixamo-round-trip-sample-fbx.js --embed-textures",
    "sample:mixamo:embedded:compressed": "node scripts/write-mixamo-round-trip-sample-fbx.js --embed-textures --compressed",
    "sample:morph": "node scripts/write-morph-sample-fbx.js",
    "sample:character": "node scripts/write-character-sample-fbx.js",
    "sample:character:compressed": "node scripts/write-character-sample-fbx.js --compressed",
    "sample:character:embedded": "node scripts/write-character-sample-fbx.js --embed-textures",
    "sample:character:embedded:compressed": "node scripts/write-character-sample-fbx.js --embed-textures --compressed",
    "sample:skinned": "node scripts/write-skinned-sample-fbx.js",
    "sample:skinned:compressed": "node scripts/write-skinned-sample-fbx.js --compressed",
    "sample:skinned:embedded": "node scripts/write-skinned-sample-fbx.js --embed-textures",
    "sample:skinned:embedded:compressed": "node scripts/write-skinned-sample-fbx.js --embed-textures --compressed",
    "sample:vertex-color": "node scripts/write-vertex-color-sample-fbx.js",
    "validate:static": "node scripts/validate-static-mesh.js",
    "validate:feature": "node scripts/validate-feature-sample.js",
    "validate:feature:compressed": "node scripts/validate-feature-sample.js --compressed",
    "validate:hierarchy": "node scripts/validate-hierarchy-sample.js",
    "validate:material": "node scripts/validate-material-sample.js",
    "validate:mixamo": "node scripts/validate-mixamo-round-trip-sample.js",
    "validate:mixamo:compressed": "node scripts/validate-mixamo-round-trip-sample.js --compressed",
    "validate:mixamo:embedded": "node scripts/validate-mixamo-round-trip-sample.js --embed-textures",
    "validate:mixamo:embedded:compressed": "node scripts/validate-mixamo-round-trip-sample.js --embed-textures --compressed",
    "validate:morph": "node scripts/validate-morph-sample.js",
    "validate:character": "node scripts/validate-character-sample.js",
    "validate:character:compressed": "node scripts/validate-character-sample.js --compressed",
    "validate:character:embedded": "node scripts/validate-character-sample.js --embed-textures",
    "validate:character:embedded:compressed": "node scripts/validate-character-sample.js --embed-textures --compressed",
    "validate:skinned": "node scripts/validate-skinned-sample.js",
    "validate:skinned:compressed": "node scripts/validate-skinned-sample.js --compressed",
    "validate:skinned:embedded": "node scripts/validate-skinned-sample.js --embed-textures",
    "validate:skinned:embedded:compressed": "node scripts/validate-skinned-sample.js --embed-textures --compressed",
    "validate:file": "node scripts/validate-fbx-file.js",
    "validate:vertex-color": "node scripts/validate-vertex-color-sample.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check-js.js"
  },
  "devDependencies": {
    "three": "^0.176.0"
  }
}
